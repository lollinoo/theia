# =============================================================================
# MikroTik Theia - Frontend Dockerfile
# =============================================================================
# Stages:
#   dev        - Vite dev server with HMR (used by docker-compose.yml)
#   builder    - Compiles static assets
#   production - Caddy serving built files, API proxy and managed HTTPS
# =============================================================================

# ---------------------------------------------------------------------------
# Stage: dev — Vite dev server with HMR
# ---------------------------------------------------------------------------
FROM node:26-alpine AS dev

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]

# ---------------------------------------------------------------------------
# Stage: builder — Compile static assets
# ---------------------------------------------------------------------------
FROM node:26-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN npm run build

# ---------------------------------------------------------------------------
# Stage: production — Caddy serving built files with API proxy and HTTPS
# ---------------------------------------------------------------------------
FROM caddy:2.11.7-alpine AS production

COPY --from=builder /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile

ENV BACKEND_PORT=8080
ENV THEIA_SITE_ADDRESS=:80

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
