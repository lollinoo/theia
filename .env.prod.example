# =============================================================================
# Theia -- Production Environment Variables
# =============================================================================
# Copy to .env.prod:  cp .env.prod.example .env.prod
# Start prod stack:   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================================

# Docker image tag to deploy (latest or a pinned release tag such as v1.9.0).
IMAGE_TAG=latest

# Port the frontend (Caddy) listens on. Default: 80
FRONTEND_PORT=80

# Enables production runtime validation for required operator-provided secrets.
# Credential encryption keys are automatically generated on first startup and shown once in the UI.
THEIA_DEPLOYMENT_ENV=production

# Password-session signing and token hashing secret (min 32 chars). REQUIRED in production.
THEIA_SESSION_SECRET=

# Dedicated bearer token for /metrics (min 32 chars). REQUIRED in production.
THEIA_METRICS_TOKEN=

# Bundled PostgreSQL password. REQUIRED when using the bundled postgres service.
# The backend automatically derives THEIA_DB_DSN from POSTGRES_PASSWORD when THEIA_DB_DSN is left blank.
POSTGRES_PASSWORD=

# Optional explicit PostgreSQL DSN (leave blank to use the bundled postgres service).
THEIA_DB_DSN=

