# =============================================================================
# Theia -- Staging Environment Variables
# =============================================================================
# Copy to .env.staging:  cp .env.staging.example .env.staging
# Start staging stack:   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
# =============================================================================

# Docker image tag to deploy (master, latest, or a version/branch tag).
IMAGE_TAG=master

# Staging frontend port (different from production to allow co-existence). Default: 3001
FRONTEND_PORT=3001

# Enables staging runtime validation for required operator-provided secrets.
# Credential encryption keys are automatically generated on first startup and shown once in the UI.
THEIA_DEPLOYMENT_ENV=staging

# Password-session signing and token hashing secret (min 32 chars). REQUIRED in staging.
THEIA_SESSION_SECRET=

# Dedicated bearer token for /metrics (min 32 chars). REQUIRED in staging.
THEIA_METRICS_TOKEN=

# Bundled PostgreSQL password. REQUIRED when using the bundled postgres service.
# The backend automatically derives THEIA_DB_DSN from POSTGRES_PASSWORD when THEIA_DB_DSN is left blank.
POSTGRES_PASSWORD=

# Optional explicit PostgreSQL DSN (leave blank to use the bundled postgres service).
THEIA_DB_DSN=

